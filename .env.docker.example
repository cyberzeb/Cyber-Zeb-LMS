# Copy to .env: cp .env.docker.example .env

# --- HTTP (default) ---
# PUBLIC_URL=http://YOUR_VPS_IP:8085
# HTTP_PORT=8085
# CORS_ORIGINS=["http://YOUR_VPS_IP:8085"]
# WEB_DOCKERFILE=Dockerfile

# --- HTTPS with self-signed cert (no domain needed) ---
# Run first: ./deploy/generate-certs.sh YOUR_VPS_IP
USE_HTTPS=true
WEB_DOCKERFILE=Dockerfile.https
HTTPS_PORT=8443
PUBLIC_URL=https://YOUR_VPS_IP:8443
HTTP_PORT=8085
CORS_ORIGINS=["https://YOUR_VPS_IP:8443"]

# SQLite (Docker volume — no Postgres needed)
DATABASE_URL=sqlite+aiosqlite:////code/data/brana_lms.db
DATABASE_URL_SYNC=sqlite:////code/data/brana_lms.db

JWT_SECRET_KEY=change-this-to-a-long-random-secret
