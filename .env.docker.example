# Copy to the project root as .env (the file docker compose reads):
#   cp .env.docker.example .env
# Prefer: ./deploy/vps-docker.sh  (fills IP, JWT, certs, ports; keeps Zoom keys)

USE_HTTPS=true
WEB_DOCKERFILE=Dockerfile.https
HTTP_PORT=7777
HTTPS_PORT=8443
PUBLIC_URL=https://YOUR_VPS_IP:8443
CORS_ORIGINS=["http://YOUR_VPS_IP:7777","https://YOUR_VPS_IP:8443"]

# SQLite (Docker volume — no Postgres needed)
DATABASE_URL=sqlite+aiosqlite:////code/data/brana_lms.db
DATABASE_URL_SYNC=sqlite:////code/data/brana_lms.db

JWT_SECRET_KEY=change-this-to-a-long-random-secret

PLATFORM_SUPER_ADMIN_EMAIL=superadmin@berana.edu
PLATFORM_SUPER_ADMIN_PASSWORD=Demo123!

# ---- Zoom Server-to-Server OAuth (put credentials HERE for Docker) ----
# Marketplace app → App Credentials. Required scopes:
#   meeting:write:meeting:admin
#   user:read:list_users:admin   (or set ZOOM_USER_EMAIL)
# Then activate the app again.
# After editing, recreate API: docker compose up -d --force-recreate api
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_EMAIL=

# Demo sign-in: fixed code 000000 and the code shown on screen. Real institutions
# must use false, with GMAIL_USER/GMAIL_APP_PASSWORD set so codes are emailed.
DEMO_LOGIN_ENABLED=true

# ==== Email (SMTP) ====
# Local testing uses Mailpit (docker compose --profile mail up -d mailpit):
# no auth, no TLS, and every message is readable at http://localhost:8025.
EMAIL_ENABLED=true
# Inside docker compose Mailpit is reached by service name, not localhost.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_FROM_EMAIL=no-reply@berana-lms.local
SMTP_FROM_NAME=Berana LMS
# Production alternative: fill these two and the Gmail host/port/STARTTLS are
# applied automatically, overriding the SMTP_* values above.
# Gmail App Password: myaccount.google.com/apppasswords — never commit a real one.
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMS_PROVIDER_API_KEY=

# Super admin sign-in codes are always random and always emailed, even while
# DEMO_LOGIN_ENABLED is true. Set to false only if you want 000000 to work for
# the platform console too (not recommended).
SUPER_ADMIN_OTP_REQUIRE_EMAIL=true
# Where "new service request" alerts go. Empty falls back to PLATFORM_SUPER_ADMIN_EMAIL.
SUPER_ADMIN_NOTIFY_EMAIL=
