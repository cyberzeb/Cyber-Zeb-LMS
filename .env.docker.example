# Copy to .env in the project root:
#   cp .env.docker.example .env
# Then edit and run:
#   docker compose up --build -d

# Public URL stakeholders will open (IP + custom port on shared VPS)
PUBLIC_URL=http://YOUR_VPS_IP:8085

# Port on the VPS host (pick one that is free - 80/443 are often taken)
HTTP_PORT=8085

# PostgreSQL (internal to Docker - not exposed on host)
POSTGRES_USER=brana_user
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=brana_lms

# Auth - generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-long-random-secret

# Must match PUBLIC_URL (same port)
CORS_ORIGINS=["http://YOUR_VPS_IP:8085"]
