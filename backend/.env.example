# ==== App ====
APP_NAME=Brana LMS API
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# ==== Database ====
DATABASE_URL=postgresql+asyncpg://brana_user:brana_pass@localhost:5432/brana_lms
DATABASE_URL_SYNC=postgresql://brana_user:brana_pass@localhost:5432/brana_lms

# ==== Auth ====
JWT_SECRET_KEY=change-this-in-every-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ==== Redis / Queue ====
REDIS_URL=redis://localhost:6379/0

# ==== Object storage (S3-compatible) ====
STORAGE_ENDPOINT=
STORAGE_BUCKET=brana-lms-files
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# ==== Zoom integration ====
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_REDIRECT_URI=

# ==== Payment provider (choose ONE for MVP per section 18.2) ====
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHAPA_SECRET_KEY=

# ==== Email / SMS ====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER_API_KEY=

# ==== CORS ====
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
