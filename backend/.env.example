# ==== App ====
APP_NAME=Berana LMS API
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# ==== Database ====
DATABASE_URL=postgresql+asyncpg://berana_user:berana_pass@localhost:5433/berana_lms
DATABASE_URL_SYNC=postgresql://berana_user:berana_pass@localhost:5433/berana_lms

# ==== Auth ====
JWT_SECRET_KEY=change-this-in-every-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Demo sign-in: fixed code 000000 and the code shown on screen. Real institutions
# must use false, with GMAIL_USER/GMAIL_APP_PASSWORD set so codes are emailed.
DEMO_LOGIN_ENABLED=true

# ==== Redis / Queue ====
REDIS_URL=redis://localhost:6379/0

# ==== Object storage (S3-compatible) ====
STORAGE_ENDPOINT=
STORAGE_BUCKET=berana-lms-files
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# ==== Zoom integration (Server-to-Server OAuth app) ====
# Marketplace scopes required: meeting:write:meeting:admin
# and user:read:list_users:admin (or set ZOOM_USER_EMAIL to a host).
# After changing scopes, activate the app again.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_EMAIL=
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_REDIRECT_URI=

# ==== Payment provider (choose ONE for MVP per section 18.2) ====
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHAPA_SECRET_KEY=

# ==== Email (SMTP) ====
# Local testing uses Mailpit (docker compose -f docker-compose.mailpit.yml up -d):
# no auth, no TLS, and every message is readable at http://localhost:8025.
EMAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_FROM_EMAIL=no-reply@berana-lms.local
SMTP_FROM_NAME=Berana LMS
# Production alternative: fill these two and the Gmail host/port/STARTTLS are
# applied automatically, overriding the SMTP_* values above.
# Gmail App Password: myaccount.google.com/apppasswords — never commit a real one.
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMS_PROVIDER_API_KEY=

# Super admin sign-in codes are always random and always emailed, even while
# DEMO_LOGIN_ENABLED is true. Set to false only if you want 000000 to work for
# the platform console too (not recommended).
SUPER_ADMIN_OTP_REQUIRE_EMAIL=true
# Where "new service request" alerts go. Empty falls back to PLATFORM_SUPER_ADMIN_EMAIL.
SUPER_ADMIN_NOTIFY_EMAIL=

# ==== Onboarding / Super Admin ====
PLATFORM_SUPER_ADMIN_EMAIL=superadmin@berana.edu
PLATFORM_SUPER_ADMIN_PASSWORD=Demo123!
FRONTEND_BASE_URL=http://localhost:5173
PUBLIC_BASE_DOMAIN=berana-lms.com

# ==== CORS ====
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
